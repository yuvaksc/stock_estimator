!test_tensors/*.pt
!test_merged_tensors/*.pt
mlruns/
mlflow.db
wandb/
~/.cache/huggingface/

# ── node / next.js ──
node_modules/
frontend/.next/
frontend/out/
frontend/node_modules/

# ── misc ──
.DS_Store
*.log
