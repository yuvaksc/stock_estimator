# ── secrets / env ──
.env
.env.*
!.env.example
frontend/.env.local
frontend/.env*.local

# ── python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── ML artifacts / trained weights (generated by training scripts) ──
Results/
*.pth
*.pt
