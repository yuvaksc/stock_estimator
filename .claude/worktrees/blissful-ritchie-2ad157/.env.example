# ════════════════════════════════════════════════════════════════════════════
#  Real-Time Stock-Sentiment AI System — environment configuration
#  Copy this file to ".env" and fill in the placeholders.  SETUP.md explains
#  exactly where each value comes from and which file consumes it.
#
#  The defaults below make the LOCAL docker-compose stack work out of the box.
#  For cloud (Supabase / Upstash / Redpanda), replace the relevant lines.
# ════════════════════════════════════════════════════════════════════════════

# ── Groq (LLM sentiment) ──  https://console.groq.com  → API Keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# For schema-guaranteed (strict) JSON use:  openai/gpt-oss-20b

# ── Database ──  local default points at the docker-compose "postgres" service.
#  Supabase:  postgresql+asyncpg://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stocks

# ── Supabase REST (only used by scripts/keepalive.py to prevent the 7-day pause)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Redis ──  local default = docker-compose "redis".  Upstash: rediss://default:<PASSWORD>@<ENDPOINT>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ── Kafka / Redpanda ──  local default = docker-compose "redpanda" (PLAINTEXT).
#  Redpanda Serverless: set bootstrap + SASL_SSL + SCRAM-SHA-256 creds.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC_SOCIAL=raw.social
KAFKA_TOPIC_TICKS=raw.ticks
KAFKA_CONSUMER_GROUP=stock-sentiment-worker

# ── Finnhub (live price ticks) ──  https://finnhub.io  → Dashboard → API key
FINNHUB_API_KEY=

# ── Reddit (social posts) ──  https://www.reddit.com/prefs/apps  → create "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=stock-sentiment-app/0.1 by u/your_reddit_username

# ── Ingestion targets ──
TICKERS=AAPL,JPM,ORCL,MSFT,AMZN,GOOG
SUBREDDITS=wallstreetbets,stocks,investing

# ── Semantic cache ──
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_SECONDS=21600
CACHE_MAX_VECTORS=5000
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── FinBERT ──
FINBERT_MODEL=ProsusAI/finbert

# ── API / auth ──  leave API_AUTH_TOKEN empty in local dev to disable auth.
API_AUTH_TOKEN=
CORS_ORIGINS=http://localhost:3000

# ── ML artifacts (paths are relative to repo root) ──
RESULTS_DIR=Results
MERGED_TENSORS_DIR=test_merged_tensors
RAW_PRICE_DIR=stock_data/price/raw
MODEL_VERSION=multimodal-regressor-v1

# ── MLOps (optional) ──
MLFLOW_TRACKING_URI=
WANDB_API_KEY=

# ── Worker ──  set true to run the Kafka consumer inside the API process (dev only)
RUN_WORKER_INPROC=false
